# GovConnect MERN Platform Environment Configuration

# Backend Server Settings
PORT=5000
NODE_ENV=development

# Database Connection (Cloud Atlas or Local Fallback)
MONGO_URI=mongodb://127.0.0.1:27017/egram_panchayat

# JWT Secret Key
JWT_SECRET=supersecretjwtkey123

# SMTP Email Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
FROM_EMAIL="GovConnect Platform <noreply@govconnect.in>"

# Default Administrative Accounts
ADMIN_EMAIL=admin@egram.com
ADMIN_PASS=Admin@123
OFFICIAL_ADMIN_EMAIL=admin@egram.gov.in
OFFICIAL_ADMIN_PASSWORD=Admin@Eg123
